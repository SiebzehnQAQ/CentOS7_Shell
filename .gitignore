# ============================================================
# CentOS 7 服务器自动化巡检与备份系统 —— Git 忽略规则
# ============================================================

# ---------- 运行期生成的目录（内容不入库，脚本会自动 mkdir） ----------
logs/
reports/
backups/
restore/

# ---------- 备份 / 归档产物 ----------
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.zip
*.gz
*.bz2
*.xz
*.bak
*.backup
*.orig
*.save

# ---------- 日志与临时文件 ----------
*.log
*.log.*
*.out
*.tmp
*.temp
*.pid
*.lock
*.swp
*.swo
*.swx
*~
.\#*
\#*\#

# ---------- 敏感信息（口令 / 密钥 / 凭据） ----------
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*_secret.conf
*_secrets.conf
*_password.conf
credentials*
password*
.passwd
.netrc

# ---------- 编辑器与 IDE ----------
.idea/
.vscode/
*.code-workspace
*.sublime-*
*.project

# ---------- 操作系统杂项 ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- Shell 本地调试残留 ----------
*.sh.bak
*.sh.orig
.shellcheckrc.local
